# Supabase Config (Fallback to local if not provided)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Mapbox Config (Fallback to list view if not provided)
NEXT_PUBLIC_MAPBOX_TOKEN="your-mapbox-token"

# AI Provider Config (Google Gemini)
# The application falls back to deterministic rule engine if missing
GOOGLE_GEMINI_API_KEY="your-gemini-api-key"
