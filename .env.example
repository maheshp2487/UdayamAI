# =========================================================================
# UdayamAI - Local Environment Variables (Example)
# 
# NOTE: The application is designed to run perfectly in a "Demo Mode" 
# even if these external API keys are missing. It will automatically 
# fallback to local seed data and deterministic logic.
# =========================================================================

# 1. Supabase Config (Database & Auth)
# If empty, the app uses a Local Fallback Repository with static seed data.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# 3. AI Provider Config (Google Gemini)
# If empty, the AI assistant falls back to a deterministic rule-engine response for scheme matching explanations.
GOOGLE_GEMINI_API_KEY="your_api_key_here"
